# Dependencies
node_modules/

# Book files (large, managed separately)
# 书籍文件较大，通过其他方式管理（云存储/单独上传）
public/uploads/*.pdf
public/uploads/*.epub
public/uploads/*.mobi
# 但保留 .gitkeep 以维持目录结构
!public/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating system and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local environment configuration
.env
.env.*
!.env.example

# Build and test output
coverage/
dist/
build/
